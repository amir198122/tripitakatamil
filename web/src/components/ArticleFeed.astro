---
/**
 * Homepage “latest posts” list — layout aligned with common Tamil magazine / Joomla blog patterns.
 */
import type { Article } from "../types/article";

interface Props {
  articles: Article[];
  heading: string;
  subheading?: string;
  /** Show legal/sample note under the list (default true). */
  showFeedNote?: boolean;
}

const { articles, heading, subheading, showFeedNote = true } = Astro.props;

function formatDate(iso: string) {
  try {
    return new Intl.DateTimeFormat("ta-IN", {
      day: "numeric",
      month: "short",
      year: "numeric",
    }).format(new Date(iso));
  } catch {
    return iso;
  }
}
---

<section class="feed" aria-labelledby="feed-title">
  <div class="feed-head">
    <h2 id="feed-title" class="feed-title">{heading}</h2>
    {subheading && <p class="feed-sub">{subheading}</p>}
  </div>
  <ul class="feed-list">
    {
      articles.map((a) => (
        <li class="feed-item" id={a.slug}>
          <article>
            <p class="meta">
              <time datetime={a.date}>{formatDate(a.date)}</time>
              <span class="sep">·</span>
              <span class="cat">{a.category}</span>
            </p>
            <h3 class="item-title">
              <a href={`${import.meta.env.BASE_URL}#${a.slug}`}>{a.title}</a>
            </h3>
            <p class="excerpt">{a.excerpt}</p>
          </article>
        </li>
      ))
    }
  </ul>
  {
    showFeedNote && (
      <p class="feed-note">
        இத் தலைப்புகள் <strong>Tripitakatamil</strong> க்கான மாதிரி உள்ளடக்கம் மட்டுமே. வேறு தளங்களின்
        உரைகளை நகலெடுக்காமல், உங்கள் சொந்தக் கட்டுரைகளால் மாற்றவும்.
      </p>
    )
  }
</section>

<style>
  .feed {
    margin: 0 0 2rem;
  }
  .feed-head {
    border-bottom: 2px solid #0582ca;
    padding-bottom: 0.5rem;
    margin-bottom: 1.1rem;
  }
  .feed-title {
    margin: 0;
    font-family: Oswald, "Noto Sans Tamil", sans-serif;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: #252422;
  }
  .feed-sub {
    margin: 0.35rem 0 0;
    color: #5a5a5a;
    font-size: 0.92rem;
  }
  .feed-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .feed-item {
    margin: 0;
    padding: 1rem 0;
    border-bottom: 1px solid #e5e5e5;
  }
  .feed-item:last-child {
    border-bottom: 0;
  }
  .meta {
    margin: 0 0 0.3rem;
    font-size: 0.85rem;
    color: #5a5a5a;
  }
  .sep {
    margin: 0 0.35rem;
  }
  .cat {
    color: #005e94;
    font-weight: 600;
  }
  .item-title {
    margin: 0 0 0.45rem;
    font-family: Oswald, "Noto Sans Tamil", sans-serif;
    font-size: 1.08rem;
    line-height: 1.35;
    font-weight: 600;
  }
  .item-title a {
    color: #0582ca;
    text-decoration: none;
  }
  .item-title a:hover {
    color: #7a7a7a;
    text-decoration: underline;
  }
  .excerpt {
    margin: 0;
    color: #333;
    font-size: 0.98rem;
    line-height: 1.6;
  }
  .feed-note {
    margin: 1.25rem 0 0;
    font-size: 0.82rem;
    color: #666;
    line-height: 1.5;
  }
</style>
