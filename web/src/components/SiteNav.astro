---
import navData from "../data/navigation.json";
import type { NavItem } from "../types/navigation";
import { withBase } from "../lib/nav-url";

const base = import.meta.env.BASE_URL;
const items = navData as NavItem[];
---

<div class="site-nav-wrap">
  <nav class="site-nav" aria-label="Primary">
    <ul class="site-nav__root">
      {
        items.map((item) => (
          <li
            class:list={["site-nav__tier1", item.children?.length ? "site-nav__tier1--has-sub" : ""]}
            data-nav-item
          >
            <span class="site-nav__row">
              <a class="site-nav__link" href={withBase(base, item.path)}>
                {item.label}
              </a>
              {item.children?.length ? (
                <button
                  type="button"
                  class="site-nav__caret"
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-label={`${item.label} — உட்பிரிவுகள்`}
                  data-nav-caret
                >
                  <span aria-hidden="true">▾</span>
                </button>
              ) : null}
            </span>
            {item.children?.length ? (
              <ul class="site-nav__sub" role="list">
                {item.children.map((ch) => (
                  <li>
                    <a href={withBase(base, ch.path)}>{ch.label}</a>
                  </li>
                ))}
              </ul>
            ) : null}
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  (function () {
    document.querySelectorAll("[data-nav-caret]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const li = btn.closest("[data-nav-item]");
        if (!li) return;
        const open = li.classList.toggle("is-open");
        btn.setAttribute("aria-expanded", open ? "true" : "false");
      });
    });

    document.addEventListener("click", (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      if (t.closest("[data-nav-item]") || t.closest("[data-nav-caret]")) return;
      document.querySelectorAll("[data-nav-item].is-open").forEach((li) => {
        li.classList.remove("is-open");
        li.querySelector("[data-nav-caret]")?.setAttribute("aria-expanded", "false");
      });
    });
  })();
</script>

<style>
  .site-nav-wrap {
    display: flex;
    align-items: stretch;
    justify-content: flex-start;
    width: 100%;
    min-width: 0;
    flex: 1;
    overflow: visible;
  }

  .site-nav {
    flex: 1;
    min-width: 0;
    font-family: "Noto Sans Tamil", "Open Sans", sans-serif;
    font-size: 0.98rem;
    font-weight: 600;
    align-self: stretch;
    display: flex;
    align-items: center;
    overflow: visible;
  }

  /**
   * Do NOT use overflow-x: auto here — it clips `position:absolute` dropdowns.
   * Tabs wrap on small widths instead.
   */
  .site-nav__root {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0 0.25rem 0 0;
    overflow: visible;
    gap: 0;
  }

  .site-nav__tier1 {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    margin: 0;
  }

  .site-nav__tier1--has-sub::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 0.45rem;
    z-index: 119;
    background: transparent;
  }

  .site-nav__root > .site-nav__tier1 + .site-nav__tier1::before {
    content: "";
    display: block;
    width: 5px;
    height: 5px;
    margin: 0 0.65rem;
    background: #0582ca;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .site-nav__row {
    display: inline-flex;
    align-items: center;
    gap: 0.05rem;
    min-height: 2.85rem;
    padding: 0 0.15rem 0 0.25rem;
  }

  .site-nav__tier1--has-sub:hover .site-nav__row,
  .site-nav__tier1--has-sub:focus-within .site-nav__row {
    background: #efefef;
    border-radius: 2px 2px 0 0;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.35rem 0.5rem 0.55rem;
    color: #1a1a1a !important;
    text-decoration: none !important;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }
  .site-nav__link:hover,
  .site-nav__link:focus-visible {
    color: #0582ca !important;
    outline: none;
  }

  .site-nav__caret {
    border: 0;
    background: transparent;
    color: #333;
    padding: 0.35rem 0.45rem 0.35rem 0.1rem;
    cursor: pointer;
    line-height: 1;
    font-size: 0.55rem;
    align-self: center;
  }
  .site-nav__caret:hover,
  .site-nav__caret:focus-visible {
    color: #0582ca;
    outline: none;
  }

  .site-nav__sub {
    position: absolute;
    top: calc(100% - 1px);
    left: 0;
    min-width: 15.5rem;
    margin: 0;
    padding: 0.4rem 0;
    list-style: none;
    background: #f5f5f5;
    border: 1px solid #4a4a4a;
    box-shadow: 2px 8px 20px rgba(0, 0, 0, 0.18);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-2px);
    transition:
      opacity 0.12s ease,
      transform 0.12s ease,
      visibility 0.12s;
    z-index: 120;
  }
  .site-nav__sub a {
    display: block;
    padding: 0.5rem 1rem;
    color: #111 !important;
    text-decoration: none !important;
    font-family: "Noto Sans Tamil", "Open Sans", sans-serif;
    font-size: 0.92rem;
    font-weight: 500;
    white-space: nowrap;
    border-bottom: 1px solid #e0e0e0;
  }
  .site-nav__sub li:last-child a {
    border-bottom: 0;
  }
  .site-nav__sub a:hover {
    background: #e8e8e8;
    color: #0582ca !important;
  }

  .site-nav__tier1--has-sub:hover .site-nav__sub,
  .site-nav__tier1--has-sub:focus-within .site-nav__sub,
  .site-nav__tier1--has-sub.is-open .site-nav__sub {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }
</style>
