---
import navData from "../data/navigation.json";
import type { NavItem } from "../types/navigation";
import { withBase } from "../lib/nav-url";

const base = import.meta.env.BASE_URL;
const items = navData as NavItem[];
---

<div class="site-nav-wrap">
  <button
    type="button"
    class="site-nav-burger"
    id="site-nav-burger"
    aria-expanded="false"
    aria-controls="site-nav-drawer"
    aria-label="மெனுவைத் திற"
  >
    <span class="site-nav-burger__bar" aria-hidden="true"></span>
    <span class="site-nav-burger__bar" aria-hidden="true"></span>
    <span class="site-nav-burger__bar" aria-hidden="true"></span>
  </button>

  <nav class="site-nav site-nav--desktop" aria-label="Primary" data-site-nav-desktop>
    <ul class="site-nav__root">
      {
        items.map((item) => (
          <li
            class:list={[
              "site-nav__item",
              item.children?.length ? "site-nav__item--has-sub" : "",
            ]}
            data-nav-item
          >
            <span class="site-nav__row">
              <a class="site-nav__link" href={withBase(base, item.path)}>
                {item.label}
              </a>
              {item.children?.length ? (
                <button
                  type="button"
                  class="site-nav__caret"
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-label={`${item.label} — உட்பிரிவுகள்`}
                  data-nav-caret
                >
                  <span aria-hidden="true">▾</span>
                </button>
              ) : null}
            </span>
            {item.children?.length ? (
              <ul class="site-nav__sub" role="list">
                {item.children.map((ch) => (
                  <li>
                    <a href={withBase(base, ch.path)}>{ch.label}</a>
                  </li>
                ))}
              </ul>
            ) : null}
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="site-nav-backdrop" id="site-nav-backdrop" hidden data-nav-backdrop></div>
  <div class="site-nav-drawer" id="site-nav-drawer" hidden data-nav-drawer>
    <div class="site-nav-drawer__head">
      <span class="site-nav-drawer__title">பிரிவுகள்</span>
      <button type="button" class="site-nav-drawer__close" id="site-nav-close" aria-label="மூடு">
        ×
      </button>
    </div>
    <nav aria-label="Mobile primary">
      <ul class="site-nav-mobile">
        {
          items.map((item) => (
            <li class="site-nav-mobile__item">
              {item.children?.length ? (
                <details class="site-nav-mobile__details">
                  <summary class="site-nav-mobile__summary">
                    <span>{item.label}</span>
                    <span class="site-nav-mobile__chev" aria-hidden="true"></span>
                  </summary>
                  <ul class="site-nav-mobile__sub">
                    <li>
                      <a href={withBase(base, item.path)}>பிரிவு முகப்பு</a>
                    </li>
                    {item.children.map((ch) => (
                      <li>
                        <a href={withBase(base, ch.path)}>{ch.label}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a class="site-nav-mobile__solo" href={withBase(base, item.path)}>
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</div>

<script>
  (function () {
    const burger = document.getElementById("site-nav-burger");
    const drawer = document.querySelector("[data-nav-drawer]");
    const backdrop = document.querySelector("[data-nav-backdrop]");
    const closeBtn = document.getElementById("site-nav-close");
    if (!burger || !drawer || !backdrop) return;

    function openDrawer() {
      drawer.hidden = false;
      backdrop.hidden = false;
      burger.setAttribute("aria-expanded", "true");
      document.body.classList.add("site-nav-drawer-open");
    }
    function closeDrawer() {
      drawer.hidden = true;
      backdrop.hidden = true;
      burger.setAttribute("aria-expanded", "false");
      document.body.classList.remove("site-nav-drawer-open");
    }

    burger.addEventListener("click", () => {
      if (drawer.hidden) openDrawer();
      else closeDrawer();
    });
    backdrop.addEventListener("click", closeDrawer);
    closeBtn?.addEventListener("click", closeDrawer);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeDrawer();
    });

    document.querySelectorAll("[data-nav-drawer] a").forEach((a) => {
      a.addEventListener("click", () => closeDrawer());
    });

    document.querySelectorAll("[data-nav-caret]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const li = btn.closest("[data-nav-item]");
        if (!li) return;
        const open = li.classList.toggle("is-open");
        btn.setAttribute("aria-expanded", open ? "true" : "false");
      });
    });

    document.addEventListener("click", (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      if (t.closest("[data-nav-item]") || t.closest("[data-nav-caret]")) return;
      document.querySelectorAll("[data-nav-item].is-open").forEach((li) => {
        li.classList.remove("is-open");
        li.querySelector("[data-nav-caret]")?.setAttribute("aria-expanded", "false");
      });
    });
  })();
</script>

<style>
  .site-nav-wrap {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    flex: 1;
    min-width: 0;
  }

  .site-nav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.5rem;
    border: 0;
    background: rgba(255, 255, 255, 0.35);
    border-radius: 4px;
    cursor: pointer;
    flex-shrink: 0;
  }
  .site-nav-burger__bar {
    display: block;
    height: 2px;
    background: var(--kt-nav, #0a1a0f);
    border-radius: 1px;
  }

  .site-nav--desktop {
    font-family: Oswald, "Noto Sans Tamil", sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .site-nav__root {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav__item {
    position: relative;
    margin: 0;
  }
  .site-nav__row {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }
  .site-nav__link {
    display: inline-block;
    padding: 0.35rem 0.5rem;
    color: var(--kt-nav, #0a1a0f) !important;
    text-decoration: none !important;
    white-space: nowrap;
  }
  .site-nav__link:hover {
    color: var(--kt-primary, #0582ca) !important;
  }
  .site-nav__caret {
    border: 0;
    background: transparent;
    color: var(--kt-nav, #0a1a0f);
    padding: 0.25rem 0.35rem;
    cursor: pointer;
    line-height: 1;
    font-size: 0.65rem;
  }
  .site-nav__caret:hover,
  .site-nav__caret:focus-visible {
    color: var(--kt-primary, #0582ca);
    outline: none;
  }

  .site-nav__sub {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 14rem;
    margin: 0;
    padding: 0.35rem 0;
    list-style: none;
    background: #f7f7f7;
    border: 1px solid #ddd;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      visibility 0.15s;
    z-index: 50;
  }
  .site-nav__sub a {
    display: block;
    padding: 0.45rem 0.85rem;
    color: #0a1a0f !important;
    text-decoration: none !important;
    font-family: "Noto Sans Tamil", "Open Sans", sans-serif;
    font-size: 0.9rem;
    font-weight: 400;
    white-space: nowrap;
  }
  .site-nav__sub a:hover {
    background: #ececec;
    color: var(--kt-primary, #0582ca) !important;
  }

  .site-nav__item--has-sub:hover .site-nav__sub,
  .site-nav__item--has-sub:focus-within .site-nav__sub,
  .site-nav__item--has-sub.is-open .site-nav__sub {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .site-nav-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 80;
  }
  .site-nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: min(20rem, 92vw);
    height: 100vh;
    background: #fff;
    z-index: 90;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }
  .site-nav-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #e5e5e5;
    background: #fafafa;
  }
  .site-nav-drawer__title {
    font-family: Oswald, "Noto Sans Tamil", sans-serif;
    font-weight: 600;
    color: #252422;
  }
  .site-nav-drawer__close {
    border: 0;
    background: transparent;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    color: #333;
    padding: 0.25rem;
  }

  .site-nav-mobile {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 2rem;
  }
  .site-nav-mobile__item {
    border-bottom: 1px solid #eee;
  }
  .site-nav-mobile__solo {
    display: block;
    padding: 0.85rem 1rem;
    color: #0582ca !important;
    text-decoration: none !important;
    font-weight: 600;
  }
  .site-nav-mobile__details {
    border: 0;
  }
  .site-nav-mobile__summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    cursor: pointer;
    font-weight: 600;
  }
  .site-nav-mobile__summary::-webkit-details-marker {
    display: none;
  }
  .site-nav-mobile__summary a {
    color: #0582ca !important;
    text-decoration: none !important;
    flex: 1;
  }
  .site-nav-mobile__chev::before {
    content: "▾";
    color: #666;
    font-size: 0.75rem;
  }
  .site-nav-mobile__sub {
    list-style: none;
    margin: 0;
    padding: 0 0 0.5rem 0.5rem;
    background: #fafafa;
  }
  .site-nav-mobile__sub a {
    display: block;
    padding: 0.5rem 0.75rem;
    color: #333 !important;
    text-decoration: none !important;
    font-size: 0.92rem;
  }

  @media (max-width: 767px) {
    .site-nav-burger {
      display: flex;
    }
    .site-nav--desktop {
      display: none;
    }
  }
</style>

<style is:global>
  body.site-nav-drawer-open {
    overflow: hidden;
  }
</style>
