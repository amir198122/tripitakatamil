---
import Layout from "../layouts/Layout.astro";
import YouTube from "../components/YouTube.astro";
import ArticleFeed from "../components/ArticleFeed.astro";
import featured from "../data/featured-video.json";
import articles from "../data/articles.json";
import type { Article } from "../types/article";

const list = articles as Article[];
---

<Layout
  title="Tripitakatamil — தமிழ் இதழ்"
  description="Tripitakatamil — Tamil publication: articles and weekly video."
>
  <header class="masthead">
    <h1 class="masthead-title">தள அறிமுகம்</h1>
    <p class="masthead-lede">
      கட்டுரை, ஆய்வு, காணொளி — ஒரே தளத்தில். பிராண்ட் <strong>Tripitakatamil</strong>; உள்ளடக்கம்
      உங்கள் சொந்த எழுத்து (வேறு தள உரைகளை நகலெடுக்க வேண்டாம்).
    </p>
  </header>

  <ArticleFeed
    articles={list}
    heading="அண்மைப் படைப்புகள்"
    subheading="Latest — edit `web/src/data/articles.json` or add Markdown posts later."
  />

  <section class="video-block" aria-labelledby="feat-heading">
    <h2 id="feat-heading" class="section-title">{featured.title}</h2>
    <YouTube url={featured.youtubeUrl} title={featured.title} />
    <p class="caption">{featured.caption}</p>
    <p class="video-hint">
      Weekly swap: edit <code>web/src/data/featured-video.json</code> in the repo and push.
    </p>
  </section>
</Layout>

<style>
  .masthead {
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e5e5;
  }
  .masthead-title {
    margin: 0 0 0.5rem;
    font-family: Oswald, "Noto Sans Tamil", sans-serif;
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    line-height: 1.2;
    font-weight: 600;
    color: #252422;
  }
  .masthead-lede {
    margin: 0;
    font-size: 1rem;
    color: #333;
    max-width: 42em;
  }
  .video-block {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid #e5e5e5;
  }
  .section-title {
    margin: 0 0 0.85rem;
    font-family: Oswald, "Noto Sans Tamil", sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: #252422;
  }
  .caption {
    margin: 0.65rem 0 0;
    color: #5a5a5a;
    font-size: 0.95rem;
  }
  .video-hint {
    margin: 0.65rem 0 0;
    font-size: 0.85rem;
    color: #5a5a5a;
  }
</style>
