{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1100px"
		},
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#f8fafc",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#0f172a",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#1e3a8a",
					"name": "Primary"
				},
				{
					"slug": "muted",
					"color": "#64748b",
					"name": "Muted"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "'Noto Sans Tamil', 'Noto Sans', system-ui, -apple-system, sans-serif",
					"slug": "body",
					"name": "Body"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.9375rem", "name": "Small" },
				{ "slug": "medium", "size": "1.0625rem", "name": "Medium" },
				{ "slug": "large", "size": "1.25rem", "name": "Large" },
				{ "slug": "x-large", "size": "clamp(1.75rem, 4vw, 2.25rem)", "name": "Extra large" }
			]
		},
		"spacing": {
			"units": [ "%", "px", "em", "rem", "vh", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "700",
					"lineHeight": "1.25"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"lineHeight": "1.3"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.125rem",
					"fontWeight": "600"
				}
			}
		}
	},
	"templateParts": {
		"header": {
			"title": "Header",
			"area": "header"
		},
		"footer": {
			"title": "Footer",
			"area": "footer"
		}
	}
}
